MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/manifestation?retryWrites=true&w=majority

# RevenueCat In-App Purchases Public API Keys (From RevenueCat Dashboard -> Project -> API Keys)
# Google Play Store (Android): starts with goog_
VITE_REVENUECAT_GOOGLE_API_KEY=goog_your_google_play_api_key_here
# Apple App Store (iOS): starts with appl_
VITE_REVENUECAT_APPLE_API_KEY=appl_your_apple_app_store_api_key_here
# Generic Public SDK Key (Optional Fallback)
VITE_REVENUECAT_API_KEY=
